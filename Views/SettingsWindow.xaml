<Window x:Class="CodexQuotaMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CodexQuotaMonitor.Converters"
        xmlns:models="clr-namespace:CodexQuotaMonitor.Models"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="设置"
        Width="340"
        Height="340"
        MinWidth="340"
        MinHeight="340"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:OpacityToBooleanConverter x:Key="OpacityToBooleanConverter" />

        <Style x:Key="CompactSettingsCardStyle"
               BasedOn="{StaticResource GlassCardStyle}"
               TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="CompactCaptionButtonStyle"
               BasedOn="{StaticResource WindowCaptionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style x:Key="SettingsFooterButtonStyle"
               BasedOn="{StaticResource GlassButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
        </Style>

        <Style x:Key="SettingsRadioButtonStyle"
               TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontFamily" Value="{DynamicResource ApplicationFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="OptionBackground"
                                Padding="8,6"
                                Background="{DynamicResource GlassCardBackground}"
                                BorderBrush="{DynamicResource GlassCardBorder}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,6,0">
                                    <Ellipse Stroke="{DynamicResource SecondaryText}"
                                             StrokeThickness="1.5" />
                                    <Ellipse x:Name="SelectionDot"
                                             Width="6"
                                             Height="6"
                                             Fill="{DynamicResource AccentBlue}"
                                             Opacity="0" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBlue}" />
                                <Setter TargetName="SelectionDot"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBackground"
                                        Property="Background"
                                        Value="{DynamicResource GlassCardHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsDataStatusDotStyle"
               TargetType="{x:Type Ellipse}">
            <Setter Property="Fill" Value="{DynamicResource WarningColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LocalLogStatusType}"
                             Value="{x:Static models:SyncStatusType.Normal}">
                    <Setter Property="Fill" Value="{DynamicResource AccentGreen}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalLogStatusType}"
                             Value="{x:Static models:SyncStatusType.Syncing}">
                    <Setter Property="Fill" Value="{DynamicResource AccentBlue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalLogStatusType}"
                             Value="{x:Static models:SyncStatusType.Failed}">
                    <Setter Property="Fill" Value="{DynamicResource ErrorColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsDataStatusTextStyle"
               BasedOn="{StaticResource BodyTextStyle}"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LocalLogStatusType}"
                             Value="{x:Static models:SyncStatusType.Normal}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentGreen}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalLogStatusType}"
                             Value="{x:Static models:SyncStatusType.Syncing}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocalLogStatusType}"
                             Value="{x:Static models:SyncStatusType.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsToggleStyle"
               TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontFamily" Value="{DynamicResource ApplicationFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Height="30" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />

                            <Border x:Name="ToggleTrack"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GlassCardBackground}"
                                    BorderBrush="{DynamicResource GlassCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Ellipse x:Name="ToggleThumb"
                                         Width="14"
                                         Height="14"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource PrimaryText}" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack"
                                        Property="Background"
                                        Value="{DynamicResource AccentBlue}" />
                                <Setter TargetName="ToggleThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource GlassCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontFamily" Value="{DynamicResource ApplicationFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBackground"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBackground"
                                                    Property="Background"
                                                    Value="{DynamicResource GlassCardHoverBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBackground"
                                                    Property="Background"
                                                    Value="{DynamicResource AccentBlue}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBoxChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11" />

                            <ContentPresenter Margin="10,0,32,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />

                            <Path Width="8"
                                  Height="4"
                                  Margin="0,0,12,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{DynamicResource SecondaryText}"
                                  IsHitTestVisible="False" />

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource PopupBackground}"
                                        BorderBrush="{DynamicResource GlassCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpacityPointStyle"
               TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Ellipse x:Name="SelectionHalo"
                                     Width="18"
                                     Height="18"
                                     Fill="{DynamicResource AccentBlue}"
                                     Opacity="0" />
                            <Ellipse x:Name="Point"
                                     Width="8"
                                     Height="8"
                                     Fill="{DynamicResource ProgressTrack}"
                                     Stroke="{DynamicResource GlassCardBorder}"
                                     StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Point" Property="Width" Value="10" />
                                <Setter TargetName="Point" Property="Height" Value="10" />
                                <Setter TargetName="Point" Property="Stroke" Value="{DynamicResource AccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionHalo" Property="Opacity" Value="0.22" />
                                <Setter TargetName="Point" Property="Width" Value="12" />
                                <Setter TargetName="Point" Property="Height" Value="12" />
                                <Setter TargetName="Point" Property="Fill" Value="{DynamicResource AccentBlue}" />
                                <Setter TargetName="Point" Property="Stroke" Value="{DynamicResource PrimaryText}" />
                                <Setter TargetName="Point" Property="StrokeThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionHalo" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="0,5,3,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}"
                              Background="Transparent">
                            <primitives:Track x:Name="PART_Track"
                                              IsDirectionReversed="True"
                                              Orientation="Vertical">
                                <primitives:Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </primitives:Track.DecreaseRepeatButton>
                                <primitives:Track.Thumb>
                                    <primitives:Thumb MinHeight="28"
                                                      Margin="1,0">
                                        <primitives:Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                                <Border x:Name="ThumbVisual"
                                                        Background="{DynamicResource GlassCardBorder}"
                                                        CornerRadius="2"
                                                        Opacity="0.58" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbVisual"
                                                                Property="Background"
                                                                Value="{DynamicResource AccentBlue}" />
                                                        <Setter TargetName="ThumbVisual"
                                                                Property="Opacity"
                                                                Value="0.82" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbVisual"
                                                                Property="Background"
                                                                Value="{DynamicResource AccentBlue}" />
                                                        <Setter TargetName="ThumbVisual"
                                                                Property="Opacity"
                                                                Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </primitives:Thumb.Template>
                                    </primitives:Thumb>
                                </primitives:Track.Thumb>
                                <primitives:Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </primitives:Track.IncreaseRepeatButton>
                            </primitives:Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid x:Name="NativeBackdropTint"
              Background="{DynamicResource NativeBackdropTint}"
              IsHitTestVisible="False"
              Opacity="{Binding ApplicationSettings.BackgroundOpacity}"
              Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource LiquidGlassDepth}" />
        </Grid>

        <Border x:Name="FallbackBackdrop"
                Background="{DynamicResource FallbackBackdropBackground}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <Grid x:Name="SettingsContent" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="12,0,7,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{StaticResource WindowTitleTextSize}"
                               Style="{StaticResource CardTitleStyle}"
                               Text="设置" />
                    <Button HorizontalAlignment="Right"
                            AutomationProperties.Name="取消并关闭设置"
                            Command="{Binding CancelCommand}"
                            Content="&#x2715;"
                            Style="{StaticResource CompactCaptionButtonStyle}"
                            ToolTip="取消" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style BasedOn="{StaticResource SettingsScrollBarStyle}"
                           TargetType="{x:Type ScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="14,10,14,10">
                    <Border Margin="0,0,0,10"
                            Style="{StaticResource CompactSettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10"
                                       Style="{StaticResource CardTitleStyle}"
                                       Text="数据来源" />
                            <StackPanel>
                                <RadioButton Content="模拟数据"
                                             GroupName="DataSource"
                                             IsChecked="{Binding ApplicationSettings.DataSourceType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:LocalDataSourceType.Mock}}"
                                             Style="{StaticResource SettingsRadioButtonStyle}" />
                                <RadioButton x:Name="CodexSessionLogsSourceOption"
                                             Margin="0,6,0,0"
                                              Content="读取本地 Codex 会话日志"
                                             GroupName="DataSource"
                                             IsChecked="{Binding ApplicationSettings.DataSourceType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:LocalDataSourceType.CodexSessionLogs}}"
                                             Style="{StaticResource SettingsRadioButtonStyle}" />
                            </StackPanel>

                            <Grid Margin="2,12,0,0"
                                  Visibility="{Binding IsChecked, ElementName=CodexSessionLogsSourceOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Margin="0,0,8,0"
                                             Style="{StaticResource SettingsDataStatusDotStyle}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource SettingsDataStatusTextStyle}"
                                               Text="{Binding LocalLogStatus}" />
                                </StackPanel>
                                <Button MinWidth="90"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ScanLocalLogsCommand}"
                                        Content="扫描日志"
                                        Style="{StaticResource GlassButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Style="{StaticResource CompactSettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       Style="{StaticResource CardTitleStyle}"
                                       Text="刷新设置" />
                            <CheckBox Content="自动刷新"
                                      IsChecked="{Binding ApplicationSettings.AutoRefreshEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SettingsToggleStyle}" />
                            <Grid Margin="0,6,0,0">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="刷新间隔" />
                                <ComboBox HorizontalAlignment="Right"
                                          ItemsSource="{Binding RefreshIntervalOptions}"
                                          SelectedItem="{Binding ApplicationSettings.RefreshIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}{0} 分钟}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <StackPanel VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Ellipse x:Name="QuotaUpdateStatusDot"
                                             Width="7"
                                             Height="7"
                                             Margin="0,0,7,0"
                                             Fill="{DynamicResource CaptionText}" />
                                    <TextBlock x:Name="QuotaUpdateStatusText"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource CaptionText}"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="尚未更新" />
                                </StackPanel>
                                <Button x:Name="UpdateQuotaButton"
                                        MinWidth="90"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="立即更新额度"
                                        Click="UpdateQuotaButton_OnClick"
                                        Content="立即更新"
                                        Style="{StaticResource GlassButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Style="{StaticResource CompactSettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       Style="{StaticResource CardTitleStyle}"
                                       Text="窗口设置" />
                            <CheckBox Content="始终置顶"
                                      IsChecked="{Binding ApplicationSettings.AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SettingsToggleStyle}" />
                            <CheckBox Content="开机启动"
                                      IsChecked="{Binding ApplicationSettings.StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SettingsToggleStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactSettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       Style="{StaticResource CardTitleStyle}"
                                       Text="显示设置" />
                            <CheckBox Content="深色模式"
                                      IsChecked="{Binding ApplicationSettings.DarkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SettingsToggleStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="背景透明度" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="{Binding ApplicationSettings.BackgroundOpacity, StringFormat={}{0:P0}}" />
                            </Grid>
                            <Grid Margin="0,4,0,0" Height="26">
                                <Border Height="2"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ProgressTrack}"
                                        CornerRadius="1" />
                                <UniformGrid Columns="9">
                                    <RadioButton AutomationProperties.Name="背景透明度 10%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.10}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="10%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 20%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.20}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="20%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 30%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.30}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="30%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 40%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.40}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="40%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 50%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.50}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="50%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 60%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.60}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="60%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 70%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.70}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="70%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 80%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.80}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="80%" />
                                    <RadioButton AutomationProperties.Name="背景透明度 90%"
                                                 GroupName="BackgroundOpacity"
                                                 IsChecked="{Binding ApplicationSettings.BackgroundOpacity, Mode=TwoWay, Converter={StaticResource OpacityToBooleanConverter}, ConverterParameter=0.90}"
                                                 Style="{StaticResource OpacityPointStyle}"
                                                 ToolTip="90%" />
                                </UniformGrid>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <TextBlock HorizontalAlignment="Left"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="10%" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="90%" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="10,7,10,9"
                    Background="Transparent">
                <Grid>
                    <Button MinWidth="72"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="退出应用"
                            Click="ExitApplicationButton_OnClick"
                            Content="退出应用"
                            Foreground="{DynamicResource ErrorColor}"
                            Style="{StaticResource SettingsFooterButtonStyle}"
                            ToolTip="关闭 Codex Quota Monitor" />

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button MinWidth="56"
                                Margin="0,0,6,0"
                                Command="{Binding CancelCommand}"
                                Content="取消"
                                Style="{StaticResource SettingsFooterButtonStyle}" />
                        <Button MinWidth="56"
                                Command="{Binding SaveCommand}"
                                Content="保存"
                                Style="{StaticResource SettingsFooterButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
