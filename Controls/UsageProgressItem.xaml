<UserControl x:Class="CodexQuotaMonitor.Controls.UsageProgressItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="RootControl"
             d:DesignHeight="54"
             d:DesignWidth="480"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Style="{StaticResource BodyTextStyle}"
                       Foreground="{DynamicResource PrimaryText}"
                       Text="{Binding Title, ElementName=RootControl}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Style="{StaticResource CaptionStyle}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:N0} / {1:N0}">
                            <Binding ElementName="RootControl" Path="Used" />
                            <Binding ElementName="RootControl" Path="Maximum" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Margin="12,0,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{Binding ProgressBrush, ElementName=RootControl}"
                           Text="{Binding Percentage, ElementName=RootControl, StringFormat={}{0:0}%}" />
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1"
                     Height="8"
                     Margin="0,8,0,0"
                     Background="{DynamicResource GlassCardBackground}"
                     BorderThickness="0"
                     Foreground="{Binding ProgressBrush, ElementName=RootControl}"
                     Maximum="100"
                     Value="{Binding Percentage, ElementName=RootControl}">
            <ProgressBar.Template>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <Grid x:Name="PART_Indicator"
                              HorizontalAlignment="Left">
                            <Border Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ProgressBar.Template>
        </ProgressBar>
    </Grid>
</UserControl>
