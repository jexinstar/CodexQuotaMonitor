<UserControl x:Class="CodexQuotaMonitor.Controls.TrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="RootControl"
             d:DesignHeight="180"
             d:DesignWidth="420"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <Grid x:Name="ChartRoot"
          Background="Transparent"
          ClipToBounds="True">
        <Canvas x:Name="GridCanvas"
                IsHitTestVisible="False">
            <Path x:Name="GridPath"
                  Opacity="0.32"
                  Stroke="{Binding GridBrush, ElementName=RootControl}"
                  StrokeThickness="1" />
        </Canvas>

        <Canvas x:Name="PlotCanvas"
                IsHitTestVisible="False">
            <Canvas.Clip>
                <RectangleGeometry x:Name="RevealClip" />
            </Canvas.Clip>

            <Path x:Name="AreaPath"
                  Fill="{Binding FillBrush, ElementName=RootControl}"
                  Opacity="0.18" />

            <Polyline x:Name="TrendLine"
                      Stroke="{Binding LineBrush, ElementName=RootControl}"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="2.5" />

            <Canvas x:Name="PointsCanvas" />
        </Canvas>

        <Canvas x:Name="LabelsCanvas"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
