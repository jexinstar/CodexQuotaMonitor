<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <FontFamily x:Key="ApplicationFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <system:Double x:Key="InterfaceTextSize">11</system:Double>
    <system:Double x:Key="WindowTitleTextSize">14</system:Double>

    <Style x:Key="BodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <Style x:Key="AppTitleStyle"
           BasedOn="{StaticResource BodyTextStyle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource WindowTitleTextSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <Style x:Key="SectionTitleStyle"
           BasedOn="{StaticResource BodyTextStyle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <Style x:Key="CardTitleStyle"
           BasedOn="{StaticResource BodyTextStyle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <Style x:Key="LargeNumberStyle"
           BasedOn="{StaticResource BodyTextStyle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <Style x:Key="CaptionStyle"
           BasedOn="{StaticResource BodyTextStyle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource InterfaceTextSize}" />
        <Setter Property="Foreground" Value="{DynamicResource CaptionText}" />
    </Style>
</ResourceDictionary>
