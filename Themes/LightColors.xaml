<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="NativeBackdropTint"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#A0DDEAF7" />
        <GradientStop Offset="0.46" Color="#98E5EFFA" />
        <GradientStop Offset="1" Color="#78EDE8F8" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LiquidGlassDepth"
                         Center="0.96,1.02"
                         GradientOrigin="1.04,1.10"
                         RadiusX="0.88"
                         RadiusY="0.72">
        <GradientStop Offset="0" Color="#385981D8" />
        <GradientStop Offset="0.42" Color="#1864B9E8" />
        <GradientStop Offset="1" Color="#0064B9E8" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="FallbackBackdropBackground" Color="#E6EEF5FF" />
    <SolidColorBrush x:Key="PopupBackground" Color="#F2F3F7FC" />
    <LinearGradientBrush x:Key="GlassCardBackground"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#64FFFFFF" />
        <GradientStop Offset="0.22" Color="#38FFFFFF" />
        <GradientStop Offset="1" Color="#20FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardBorder"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#C0FFFFFF" />
        <GradientStop Offset="0.48" Color="#78FFFFFF" />
        <GradientStop Offset="1" Color="#38FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardHoverBackground"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#78FFFFFF" />
        <GradientStop Offset="1" Color="#38FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassCardTopHighlight" Color="#B0FFFFFF" />
    <SolidColorBrush x:Key="GlassDivider" Color="#5AFFFFFF" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#68283955" />

    <SolidColorBrush x:Key="PrimaryText" Color="#FF10203A" />
    <SolidColorBrush x:Key="SecondaryText" Color="#FF344765" />
    <SolidColorBrush x:Key="CaptionText" Color="#FF60718E" />

    <SolidColorBrush x:Key="AccentBlue" Color="#FF168FE3" />
    <SolidColorBrush x:Key="AccentGreen" Color="#FF159E8C" />
    <SolidColorBrush x:Key="AccentPurple" Color="#FF7652D6" />
    <SolidColorBrush x:Key="WarningColor" Color="#FFD48A00" />
    <SolidColorBrush x:Key="ErrorColor" Color="#FFE1455A" />

    <Color x:Key="GlassShadowColor">#30324868</Color>
</ResourceDictionary>
